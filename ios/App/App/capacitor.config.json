{
	"appId": "com.sorakanji.app",
	"appName": "SoraKanji",
	"webDir": "www",
	"plugins": {
		"FirebaseAuthentication": {
			"providers": [
				"apple.com",
				"google.com"
			]
		}
	},
	"experimental": {
		"ios": {
			"spm": {
				"packageOptions": {
					"@capacitor-firebase/authentication": {
						"symlink": true
					}
				},
				"packageTraits": {
					"@capacitor-firebase/authentication": [
						"Google"
					]
				},
				"swiftToolsVersion": "6.1"
			}
		}
	},
	"packageClassList": [
		"FirebaseAuthenticationPlugin"
	]
}
